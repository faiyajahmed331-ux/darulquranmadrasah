# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# database (SQLite dev database — কখনোই git-এ যাবে না)
/prisma/*.db
/prisma/*.db-journal
/prisma/migrations/dev.db*

# uploads (ব্যবহারকারীর আপলোড করা ফাইল — আলাদা Backup নিতে হবে)
/storage/uploads/*
!/storage/uploads/.gitkeep

# backups
/backups/*
!/backups/.gitkeep

# env
.env
.env.local
.env*.local

# logs
/logs/*
!/logs/.gitkeep
npm-debug.log*

# misc
.DS_Store
*.pem
/coverage
.vscode/*
!.vscode/extensions.json
