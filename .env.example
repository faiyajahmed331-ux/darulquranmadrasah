# =====================================================================
# দারুল কোরআন ক্যাডেট মাদ্রাসা — Environment Example
# এই ফাইলটি কপি করে ".env" নাম দিন, তারপর নিচের মানগুলো পূরণ করুন।
# কোথাও আসল Password / Secret কমিট করবেন না।
# =====================================================================

# --- Database -------------------------------------------------------
# ডেভেলপমেন্ট (SQLite, এখনই কাজ করে)।
# লক্ষ্য রাখুন: SQLite-এর relative path schema.prisma ফাইলের সাপেক্ষে হিসাব হয়,
# তাই "file:./dev.db" মানে আসলে prisma/dev.db ফাইল তৈরি হবে।
DATABASE_URL="file:./dev.db"

# প্রোডাকশন (PostgreSQL) — শুধু provider ও এই লাইন বদলাতে হবে:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/madrasa?schema=public&sslmode=require"

# --- Auth / Security ------------------------------------------------
# ৩২+ বাইটের র‍্যান্ডম স্ট্রিং দিন। জেনারেট করার কমান্ড:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="CHANGE_ME_use_a_long_random_string_at_least_32_bytes"

# Session cookie-র নাম
SESSION_COOKIE_NAME="dqc_session"

# Session-এর সর্বোচ্চ আয়ু (ঘণ্টা)
SESSION_TTL_HOURS="12"

# --- Application ----------------------------------------------------
APP_NAME="দারুল কোরআন ক্যাডেট মাদ্রাসা"
# ডোমেইন না থাকলে সার্ভারের IP দিয়ে দিন; পরে ডোমেইন কিনে https দিলে এখানেই বদলান।
# উদাহরণ: "http://192.168.0.10:3000" (এখন)  →  "https://madrasa.example.com" (পরে)
APP_URL="http://localhost:3000"

# Session Cookie-কে শুধু HTTPS-এ পাঠানো হবে কিনা (Secure ফ্ল্যাগ)।
# ডোমেইন/HTTPS এখনো না থাকলে খালি রাখুন → APP_URL http হওয়ায় false হবে, http-এ লগইন চলবে।
# পরে APP_URL https করলে স্বয়ংক্রিয়ভাবে true হয়ে যাবে। জোর করে দিতে চাইলে "true"/"false" দিন।
COOKIE_SECURE=""

# ডিফল্ট ভাষা: bn | en | ar
DEFAULT_LOCALE="bn"

# --- File Storage ---------------------------------------------------
# ডেভেলপমেন্ট: local disk
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"

# প্রোডাকশন (S3-সদৃশ অবজেক্ট স্টোরেজ) — STORAGE_DRIVER="s3" দিলে এই মানগুলো লাগবে
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
# MinIO-র মতো S3-সদৃশ সার্ভিসে bucket হোস্ট-নামের বদলে path-এ যায় → "true"।
# AWS S3 (আসল) ব্যবহার করলে virtual-host দরকার → "false"।
S3_FORCE_PATH_STYLE="true"

# আপলোড সীমা
MAX_IMAGE_MB="5"
MAX_DOCUMENT_MB="15"
MAX_VIDEO_MB="200"

# --- Excel Automation ----------------------------------------------
# Scheduled Excel সত্যিই তৈরি হবে কিনা (Scheduler চালু থাকলে)
EXCEL_AUTOMATION_ENABLED="true"
EXCEL_OUTPUT_DIR="./storage/exports"

# --- Scheduler (নির্ধারিত কাজ / Scheduled Jobs) ---------------------
# সার্ভারে ব্যাকগ্রাউন্ড ডেমন নেই। OS cron / Windows Task Scheduler থেকে
# প্রতি ৫ মিনিটে POST /api/jobs/run-due ডাকলে বকেয়া কাজ (Excel/ব্যাকআপ)
# সত্যিকারভাবে চলে। সেই অনুরোধে প্রমাণপত্র হিসেবে এই গোপন টোকেন পাঠাতে হয়:
#   curl -X POST https://your-domain/api/jobs/run-due -H "x-scheduler-token: <TOKEN>"
# খালি রাখলে endpoint বন্ধ (503) থাকে — কেউ ভুয়া সফলতা দেখাতে পারবে না।
SCHEDULER_TOKEN=""

# --- Backup ---------------------------------------------------------
BACKUP_DIR="./backups"
# SQLite হলে প্রোডাকশনে PATH সহ sqlite3 CLI দরকার; PostgreSQL হলে pg_dump
SQLITE_BIN="sqlite3"
PG_DUMP_BIN="pg_dump"

# --- Email (ঐচ্ছিক — খালি থাকলে Email পাঠানো হবে না, শুধু In-app Notification) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# 465 পোর্ট হলে implicit TLS স্বয়ংক্রিয়ভাবে ধরা হয়; জোর করে দিতে চাইলে "true"/"false"
SMTP_SECURE=""

# --- SMS (ঐচ্ছিক — খালি থাকলে SMS পাঠানো হবে না) -------------------
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
# গেটওয়ের HTTP endpoint (POST/GET) — এটা ও API Key দুটোই থাকলে SMS যাবে
SMS_API_URL=""
SMS_METHOD="POST"

# --- WhatsApp (ঐচ্ছিক — Cloud API; খালি থাকলে পাঠানো হবে না) --------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# ডিফল্ট Meta Graph API; সাধারণত বদলানোর দরকার নেই
WHATSAPP_API_BASE_URL="https://graph.facebook.com"

# --- AI Agent (ঐচ্ছিক — খালি থাকলে AI Agent শুধু নিয়মভিত্তিক উত্তর দেবে) ---
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
# OpenAI-সামঞ্জস্যপূর্ণ Base URL (যেমন https://api.openai.com/v1)
AI_BASE_URL=""

# --- Payment Gateway (ঐচ্ছিক — bKash/Nagad স্বয়ংক্রিয় যাচাই) -------
PAYMENT_PROVIDER=""
# যাচাই-endpoint (POST) — এটা ও API Key দুটোই থাকলে স্বয়ংক্রিয় যাচাই চালু
PAYMENT_VERIFY_URL=""
PAYMENT_VERIFY_API_KEY=""

# --- Logging --------------------------------------------------------
LOG_LEVEL="info"
LOG_DIR="./logs"
