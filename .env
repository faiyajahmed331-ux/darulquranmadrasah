# =====================================================================

# SQLite পাথ schema.prisma ফাইলের সাপেক্ষে → আসলে prisma/dev.db তৈরি হয়
DATABASE_URL="file:./dev.db"

# এই সেশন-সিক্রেটটি এই মেশিনের জন্য র‍্যান্ডমভাবে তৈরি করা হয়েছে।
# প্রোডাকশনে অবশ্যই নতুন সিক্রেট ব্যবহার করুন।
SESSION_SECRET="e174297d73b94119d888780f2d6b28877219931ce3a1bda97dd255a18d6e5b4a4f965d3047ba5610a4e5b859d741ce81"
SESSION_COOKIE_NAME="dqc_session"
SESSION_TTL_HOURS="12"

APP_NAME="দারুল কোরআন ক্যাডেট মাদ্রাসা"
# ডোমেইন না থাকলে সার্ভারের IP দিন (যেমন http://192.168.0.10:3000)।
# পরে ডোমেইন+HTTPS যোগ করলে এখানে https://... বসালেই Cookie স্বয়ংক্রিয়ভাবে Secure হবে।
APP_URL="http://localhost:3000"
# খালি = APP_URL http হলে false (এখনকার IP-ভিত্তিক ব্যবহারে দরকার)।
COOKIE_SECURE=""
DEFAULT_LOCALE="bn"

STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"

MAX_IMAGE_MB="5"
MAX_DOCUMENT_MB="15"
MAX_VIDEO_MB="200"

EXCEL_AUTOMATION_ENABLED="true"
EXCEL_OUTPUT_DIR="./storage/exports"

BACKUP_DIR="./backups"
SQLITE_BIN="sqlite3"
PG_DUMP_BIN="pg_dump"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""

LOG_LEVEL="info"
LOG_DIR="./logs"

